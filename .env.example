# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-project-publishable-key
# Legacy projects can use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
# Server-only. Required to enable live admin and registration database operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare Turnstile CAPTCHA. Site key is public; secret key must remain server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Admin username login (the Auth email remains server-side and is never emailed during login)
ADMIN_LOGIN_USERNAME=your-admin-username
ADMIN_LOGIN_EMAIL=admin-account@example.com

# Used to build the email magic-link callback URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional production integrations. Never expose these with NEXT_PUBLIC_.
RESEND_API_KEY=
ADMIN_EMAIL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

