# Copy to .env.local and fill with credentials from the NEW portal Supabase project.
# Do not use values from the public website or any existing production project.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-NEW-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_NEW_PROJECT_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_NEW_PROJECT_SERVICE_ROLE_KEY

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_DOMAIN=portal.avishkarait.online
NEXT_PUBLIC_PARTICIPANT_PORTAL_URL=http://localhost:3000/participant
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep this stable and server-only; it encrypts temporary passwords and participant QR tokens at rest.
PORTAL_CREDENTIAL_ENCRYPTION_KEY=BASE64_ENCODED_32_BYTE_SECRET
